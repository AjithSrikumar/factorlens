{
  "crons": [
    {
      "path": "/api/cron/eod",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/cron/mf-eod",
      "schedule": "30 17 * * *"
    },
    {
      "path": "/api/nav-sync?action=daily",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/nav-sync?action=normalize",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/cron/eod?recompute_all=true",
      "schedule": "0 3 * * 6"
    },
    {
      "path": "/api/cron/mf-eod",
      "schedule": "0 4 * * 6"
    },
    {
      "path": "/api/cron/news-scrape",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/news-cleanup",
      "schedule": "0 2 * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/eod/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/mf-eod/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/nav-sync/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/news-scrape/route.ts": {
      "maxDuration": 120
    }
  }
}
