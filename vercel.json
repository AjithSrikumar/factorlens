{
  "crons": [
    {
      "path": "/api/cron/eod",
      "schedule": "30 12 * * 1-5"
    },
    {
      "path": "/api/cron/mf-eod",
      "schedule": "30 17 * * 1-5"
    },
    {
      "path": "/api/nav-sync?action=daily",
      "schedule": "0 18 * * 1-5"
    },
    {
      "path": "/api/nav-sync?action=normalize",
      "schedule": "30 18 * * 0"
    },
    {
      "path": "/api/cron/eod?recompute_all=true",
      "schedule": "0 3 * * 6"
    },
    {
      "path": "/api/cron/mf-eod",
      "schedule": "0 4 * * 6"
    }
  ],
  "functions": {
    "src/app/api/cron/eod/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/mf-eod/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/nav-sync/route.ts": {
      "maxDuration": 300
    }
  }
}
